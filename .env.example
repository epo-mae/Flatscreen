# Copy these values into the service environment. Do not commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.production
FLATSCREEN_ALLOWED_HOSTS=flatscreen.example.com
FLATSCREEN_DATA_DIR=/var/lib/flatscreen
FLATSCREEN_SECRET_KEY=replace-with-a-random-string-of-at-least-50-characters

# Weather uses Open-Meteo and needs outbound HTTPS access. No API key is required.
